{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis", "checks", "suggestedCode"],
  "properties": {
    "analysis": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "suggestedCode": { "type": ["string", "null"], "maxLength": 30000 }
  }
}
