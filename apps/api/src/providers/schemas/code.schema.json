{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "code", "language"],
  "properties": {
    "message": { "type": "string", "minLength": 1, "maxLength": 30000 },
    "code": { "type": "string", "maxLength": 30000 },
    "language": { "const": "cpp" }
  }
}
