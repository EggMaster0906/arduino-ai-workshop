{
  "name": "arduino-generative-ai-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "content/courses/*",
    "tests/e2e"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @arduino-ai/web",
    "dev:api": "npm run dev --workspace @arduino-ai/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test --workspace @arduino-ai/e2e",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.7",
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
