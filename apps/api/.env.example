# HTTP server
PORT=3000
NODE_ENV=development

# Comma-separated, exact browser origins. Do not use * in production.
FRONTEND_ORIGIN=http://localhost:5173

# Use mock during local development and tests. PROMPT_COACH_PROVIDER overrides AI_PROVIDER.
AI_PROVIDER=mock
PROMPT_COACH_PROVIDER=mock

# The backend allowlist only accepts this model. The client cannot override it.
CODEX_MODEL=gpt-5.4-mini

# Set this only in the deployed server secret store; never commit a real key.
# CODEX_API_KEY=

# Fixed, empty directory used as Codex CLI's read-only working directory.
CODEX_WORKDIR=/tmp/arduino-ai-codex-workdir

# Traffic and AI resource limits
MAX_AI_CONCURRENCY=5
AI_REQUEST_TIMEOUT_MS=60000
REQUEST_TIMEOUT_MS=65000
REQUEST_BODY_LIMIT_BYTES=65536
PROMPT_COACH_RATE_LIMIT=10

# Mock modes: success, incomplete, timeout, malformed
MOCK_AI_SCENARIO=success
